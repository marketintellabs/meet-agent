# === LLM Provider (required) ===
# Any OpenAI-compatible endpoint: DeepInfra, OpenAI, Ollama, etc.
LLM_API_BASE=https://api.deepinfra.com/v1/openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=nvidia/Nemotron-Mini-4B-Instruct

# === STT Provider ===
# Options: faster-whisper (local), deepinfra, openai
STT_PROVIDER=deepinfra
# Only needed for API-based STT
STT_API_KEY=your-api-key-here
STT_API_BASE=https://api.deepinfra.com/v1
STT_MODEL=openai/whisper-large-v3-turbo

# === TTS Provider ===
# Options: piper (local), openai
TTS_PROVIDER=openai
TTS_API_KEY=your-api-key-here
TTS_VOICE=alloy

# === Agent Identity ===
AGENT_NAME=MeetAgent
AGENT_SYSTEM_PROMPT=You are a helpful AI meeting assistant. Listen to the conversation and contribute when asked.

# === Avatar (v0.2) ===
# AVATAR_ENABLED=false
# AVATAR_IMAGE=./avatar.png
# AVATAR_GPU_PROVIDER=local
# RUNPOD_API_KEY=your-key
# RUNPOD_ENDPOINT_ID=your-endpoint
